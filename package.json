{
  "name": "torchmap-local",
  "version": "0.5.0",
  "description": "Local model lineage, training runs and checkpoint-linked evaluation using the TorchMap protocol.",
  "type": "module",
  "license": "MIT",
  "author": "FunkyFrog1",
  "repository": {
    "type": "git",
    "url": "https://github.com/FunkyFrog1/TorchMap.git"
  },
  "bugs": {
    "url": "https://github.com/FunkyFrog1/TorchMap/issues"
  },
  "homepage": "https://github.com/FunkyFrog1/TorchMap#readme",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test --config tests/playwright.config.js",
    "format": "prettier --write src tests docs examples *.md *.json .github",
    "tm": "node src/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "model-lineage",
    "model-versioning",
    "machine-learning",
    "local-first",
    "retro-futurism"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "bin": {
    "torchmap": "src/cli.mjs"
  }
}
